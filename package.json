{
  "name": "gilded-rose-kata-challenge-qover",
  "version": "1.0.0",
  "description": "Gilded Rose kata Challenge for Qover",
  "scripts": {
    "precompile": "rimraf dist",
    "compile": "tsc",
    "lint": "eslint \"{app,test}/**/*.ts\"",
    "lint:fix": "eslint \"{app,test}/**/*.ts\" --fix",
    "pretest": "rimraf dist",
    "test": "vitest --coverage",
    "test:agedbrie": "vitest test/vitest/rules/aged-brie.spec.ts --coverage",
    "test:backstage": "vitest test/vitest/rules/backstage-passes.spec.ts --coverage",
    "test:conjured": "vitest test/vitest/rules/conjured-items.spec.ts --coverage",
    "test:normal": "vitest test/vitest/rules/normal-items.spec.ts --coverage",
    "test:sulfuras": "vitest test/vitest/rules/sulfuras.spec.ts --coverage"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^18.14.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-istanbul": "^0.28.5",
    "eslint": "^8.57.1",
    "rimraf": "^4.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.4.4",
    "vite-tsconfig-paths": "^4.0.5",
    "vitest": "^0.28.5"
  }
}
